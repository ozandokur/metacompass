    "{Subject} {scope}",
    "Analysis of {subject} {scope}",
    "Need a view of {subject} {scope}",
    "Can we see {subject} {scope}?",
    "Request: {subject} {scope}",
    "Deep dive into {subject} {scope}",
    "Numbers on {subject} {scope}",
    "Help with {subject} {scope}",
    "Looking for {subject} {scope}",
    "Question about {subject} {scope}",
    "{Subject} {scope} for review",
    "Breakdown of {subject} {scope}"
  ],
