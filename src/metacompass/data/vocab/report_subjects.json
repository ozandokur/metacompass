{
  "_comment": "Report names are built as a qualifier pattern around one of the subject's name stems plus an optional format word. The first stem is the canonical one; the others are how other teams would title the same topic. Each (subject, qualifier) pair is used once, and the generator rejects any name whose token Jaccard similarity with an existing name exceeds 0.6, so only the designed noise pairs look alike (I19). Description templates are dealt in shuffled rounds so no opening dominates (I20). n_reports counts base reports; near-duplicate partners (N1) and replacements (N2) are added on top.",
  "formats": [
    {"text": "", "weight": 35},
    {"text": " Dashboard", "weight": 25},
    {"text": " Report", "weight": 15},
    {"text": " Overview", "weight": 10},
    {"text": " Tracker", "weight": 8},
    {"text": " Scorecard", "weight": 7}
  ],
  "qualifiers": {
    "none": {"pattern": "{base}", "phrase": "", "tags": [], "tables": []},
    "region": {"pattern": "{base} by Region", "phrase": "split by sales region", "tags": ["region"], "tables": ["dim_region"]},
    "dealer": {"pattern": "{base} by Dealer", "phrase": "for each dealership", "tags": ["dealer"], "tables": ["dim_dealer"]},
    "model": {"pattern": "{base} by Model", "phrase": "per vehicle model", "tags": ["model"], "tables": ["dim_vehicle"]},
    "segment": {"pattern": "{base} by Customer Segment", "phrase": "per customer segment", "tags": ["customers"], "tables": ["dim_customer"]},
    "category": {"pattern": "{base} by Part Category", "phrase": "per part category", "tags": ["part category"], "tables": ["dim_part"]},
    "warehouse": {"pattern": "{base} by Warehouse", "phrase": "for each warehouse", "tags": ["warehouse"], "tables": ["dim_warehouse"]},
    "supplier": {"pattern": "{base} by Supplier", "phrase": "per supplier", "tags": ["suppliers"], "tables": ["dim_supplier"]},
    "campaign": {"pattern": "{base} by Campaign", "phrase": "for each marketing campaign", "tags": ["campaigns"], "tables": ["dim_campaign"]},
    "weekly": {"pattern": "Weekly {base}", "phrase": "on a weekly basis", "tags": ["weekly"], "tables": ["dim_date"]},
    "monthly": {"pattern": "Monthly {base}", "phrase": "month by month", "tags": ["monthly"], "tables": ["dim_date"]},
    "yoy": {"pattern": "{base} YoY", "phrase": "compared with the same period last year", "tags": ["YoY"], "tables": ["dim_date"]},
    "mtd": {"pattern": "{base} MTD", "phrase": "for the month to date", "tags": ["MTD"], "tables": ["dim_date"]},
    "exec": {"pattern": "{base} Executive Summary", "phrase": "summarised for the leadership team", "tags": ["executive"], "tables": [], "no_format": true},
    "trend": {"pattern": "{base} Trend", "phrase": "as a rolling 13-month trend", "tags": ["trend"], "tables": ["dim_date"], "no_format": true}
  },
  "description_templates": [
    "Shows {measure}{q}.",
    "Tracks {measure}{q}. Used by {audience} in their {cadence} review.",
    "{Measure}{q}, with drill-down to {drill}.",
    "Summary of {measure}{q}. Refreshed {refresh} from the data warehouse.",
    "{Measure}{q}. Built for {audience}, with filters for period and {filter}.",
    "Helps {audience} follow {measure}{q} and spot problems early.",
    "Gives {audience} a view of {measure}{q}.",
    "Covers {measure}{q}; figures refresh {refresh}.",
    "Where {audience} look up {measure}{q}.",
    "{Measure}{q}. Includes a trend line and drill-down to {drill}."
  ],
  "template_fillers": {
    "cadence": ["weekly", "monthly", "quarterly"],
    "refresh": ["daily", "every morning", "overnight", "every hour"],
    "filter": ["region", "dealer", "model", "channel"]
  },
  "vague_descriptions": [
    "Legacy view. Ask the owner for context.",
    "Copied from an older workspace. Description to be added.",
    "Built for a one-off leadership request; see the owner.",
    "Work in progress. Numbers not yet validated.",
    "Internal view for the team. Contact the owner before sharing.",
    "TBD",
    "Old layout kept for reference."
  ],
